# Copy to .env or export before running ingest.py / search.py

# Elasticsearch endpoint (docker-compose exposes http://localhost:9200)
ES_URL=http://localhost:9200

# Only needed when Elasticsearch security is enabled. The dev compose file
# ships with security disabled, so this can stay empty.
ES_API_KEY=

# Optional: override the sentence-transformers fallback model
# EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
